# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. This file is not — so it must never hold a real
# value. Placeholders only.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
# Both of these are sent to the browser on purpose: the browser client needs
# them, and access is decided by row-level security, not by holding the key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses row-level security completely. Read only by scripts/seed.mjs, from
# a terminal. Never give this a NEXT_PUBLIC_ prefix, and never set it on the
# hosting provider — the deployed app has no use for it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Lets `npm run seed` purge the deployed catalog cache when it finishes.
# Any random string; the same value goes in your hosting environment.
#   node -e "console.log(crypto.randomUUID())"
REVALIDATE_SECRET=

# Where that purge request is sent. Local-only; omit and the seed just skips it.
SITE_URL=https://your-deployment.vercel.app
